# Copy to api/.env and fill in real values.

ENVIRONMENT=development

# Any PostgreSQL URL works (local Docker, Neon, Supabase). postgres:// and
# ?sslmode=require are normalised automatically for the asyncpg driver.
DATABASE_URL=postgresql://splity:splity@localhost:5432/splity

# At least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# AI. LLM_MODEL is any LiteLLM model string (e.g. gemini/gemini-3.8-flash,
# anthropic/claude-haiku-4-5, openai/gpt-4o-mini; non-Gemini providers read their
# own *_API_KEY variable).
GEMINI_API_KEY=
LLM_MODEL=gemini/gemini-3.8-flash

# JSON list of allowed browser origins.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
