# Backend Environment Variables Example Template
# Copy this file to .env and replace placeholders with actual values

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Neon PostgreSQL or Local PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/expense_splitter

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here

# Google Gemini AI API Key (Required for AI assistant & OCR features)
GEMINI_API_KEY=your_gemini_api_key_here

# Email Notification Configuration (Gmail SMTP / SendGrid)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=your-email@gmail.com

# Frontend Application URL
APP_DOMAIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
